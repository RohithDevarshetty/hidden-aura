generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String         @id @default(uuid())
  username                 String         @unique @db.VarChar(50)
  email                    String?        @unique @db.VarChar(255)
  emailVerified            Boolean        @default(false)
  accessCodeHash           String         @db.VarChar(255)
  googleId                 String?        @unique @db.VarChar(255)
  profilePictureUrl        String?
  bio                      String?        @db.Text
  notificationPreferences  Json           @default("{\"email\": true, \"push\": true, \"sms\": false}")
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  lastLoginAt              DateTime?
  isActive                 Boolean        @default(true)

  questions                Question[]
  notifications            Notification[]

  @@index([username])
  @@index([email])
  @@index([googleId])
}

model Question {
  id            String    @id @default(uuid())
  userId        String
  username      String    @db.VarChar(50)
  questionText  String    @db.VarChar(280)
  templateId    String?   @db.VarChar(50)
  isPublic      Boolean   @default(false)
  answerCount   Int       @default(0)
  viewCount     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers       Answer[]

  @@index([userId])
  @@index([isPublic, deletedAt])
  @@index([createdAt(sort: Desc)])
}

model Answer {
  id                     String    @id @default(uuid())
  questionId             String
  answerText             String    @db.VarChar(500)
  deviceFingerprintHash  String    @db.VarChar(255)
  ipAddressHash          String    @db.VarChar(255)
  isRead                 Boolean   @default(false)
  isFavorite             Boolean   @default(false)
  reactions              Json      @default("[]")
  createdAt              DateTime  @default(now())
  flaggedAt              DateTime?
  flagReason             String?   @db.Text

  question               Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reports                Report[]

  @@index([questionId])
  @@index([createdAt(sort: Desc)])
  @@index([deviceFingerprintHash])
}

model Template {
  id              String   @id @db.VarChar(50)
  name            String   @db.VarChar(100)
  description     String?  @db.Text
  previewImageUrl String?
  cssConfig       Json
  isPremium       Boolean  @default(false)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([displayOrder])
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  type       String    @db.VarChar(50)
  title      String    @db.VarChar(255)
  message    String?   @db.Text
  answerId   String?
  questionId String?
  isRead     Boolean   @default(false)
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt(sort: Desc)])
}

model Report {
  id                    String    @id @default(uuid())
  answerId              String
  reason                String    @db.VarChar(50)
  details               String?   @db.Text
  reportedByDeviceHash  String?   @db.VarChar(255)
  status                String    @default("pending") @db.VarChar(50)
  createdAt             DateTime  @default(now())
  reviewedAt            DateTime?
  reviewedBy            String?

  answer                Answer    @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@index([answerId])
  @@index([status])
}
